,EAAA;AAAA,SAAA,CADA;AAEA,QAAA,UAAA,EAAA,CAAA;AAAA,UAAA,QAAA,EAAA,IAAA;AAAA,UAAA,OAAA,EAAA;AAAA,SAAA;AAFA,OAVA;AAcA,MAAA,aAAA,EAAA,CACA;AAAA,QAAA,IAAA,EAAA,UAAA;AAAA,QAAA,KAAA,EAAA,IAAA;AAAA,QAAA,IAAA,EAAA,UAAA;AAAA,QAAA,IAAA,EAAA,UAAA;AAAA,QAAA,WAAA,EAAA;AAAA,OADA,EAEA;AAAA,QAAA,IAAA,EAAA,UAAA;AAAA,QAAA,KAAA,EAAA,MAAA;AAAA,QAAA,IAAA,EAAA,YAAA;AAAA,QAAA,IAAA,EAAA,YAAA;AAAA,QAAA,WAAA,EAAA;AAAA,OAFA;AAdA,KAAA;AAmBA,GAvBA;AAwBA,EAAA,OAAA,EAAA;AACA,IAAA,gBADA,8BACA;AACA,MAAA,UAAA,CAAA,MAAA;AACA,KAHA;AAIA,IAAA,aAJA,yBAIA,IAJA,EAIA;AAAA;;AACA,UAAA,IAAA,KAAA,MAAA,EAAA;AACA,aAAA,OAAA,CAAA,IAAA,CAAA,GAAA;AACA;;AACA,UAAA,IAAA,KAAA,QAAA,EAAA;AACA,aAAA,QAAA,CAAA,SAAA,EAAA,MAAA,EAAA,IAAA,CAAA,YAAA;AACA;AACA,UAAA,KAAA,CAAA,MAAA;;AACA,UAAA,KAAA,CAAA,OAAA,CAAA,IAAA,CAAA,GAAA;AACA,SAJA;AAKA;;AACA,UAAA,IAAA,KAAA,UAAA,EAAA;AACA,aAAA,YAAA;AACA;AACA,KAlBA;AAmBA,IAAA,KAnBA,mBAmBA;AACA,WAAA,aAAA,CAAA,OAAA,GAAA,KAAA;AACA,KArBA;AAsBA,IAAA,YAtBA,0BAsBA;AACA,WAAA,aAAA,CAAA,OAAA,GAAA,IAAA;AACA,KAxBA;AAyBA,IAAA,IAzBA,kBAyBA;AAAA;;AACA,UAAA,IAAA,GAAA,KAAA,KAAA,CAAA,gBAAA,EAAA,YAAA,EAAA;;AACA,UAAA,IAAA,EAAA;AACA,YAAA,KAAA,YAAA,CAAA,QAAA,KAAA,KAAA,YAAA,CAAA,UAAA,EAAA;AACA,eAAA,QAAA,CAAA,KAAA,CAAA,YAAA;AACA;AACA,SAJA,CAKA;;;AACA,QAAA,cAAA,CAAA,KAAA,YAAA,CAAA,CAAA,IAAA,CAAA,UAAA,GAAA,EAAA;AACA,UAAA,MAAA,CAAA,QAAA,CAAA,OAAA,CAAA,GAAA,CAAA,GAAA;;AACA,UAAA,MAAA,CAAA,KAAA,CAAA,KAAA;;AACA,UAAA,MAAA,CAAA,KAAA,CAAA,QAAA;AACA,SAJA;AAKA;AACA;AAvCA;AAxBA,CAAA","sourcesContent":["<template>\n    <div class=\"header\">\n        <span class=\"collapse\">\n            <i class=\"el-icon-s-fold\"></i>\n        </span>\n        <div class=\"user-info\">\n            <i class=\"el-icon-chat-line-square\"></i>\n            <i class=\"el-icon-full-screen\" @click=\"handleFullScreen\"></i>\n            <el-dropdown @command=\"handleCommand\">\n            <span class=\"el-dropdown-link\">\n                {{account}}<i class=\"el-icon-caret-bottom\"></i>\n            </span>\n                <el-dropdown-menu slot=\"dropdown\">\n                    <el-dropdown-item command=\"home\">\n                        <i class=\"el-icon-s-home\"></i>\n                        网站首页\n                    </el-dropdown-item>\n                    <el-dropdown-item command=\"password\">\n                        <i class=\"el-icon-edit\"></i>\n                        修改密码\n                    </el-dropdown-item>\n                    <el-dropdown-item command=\"logout\">\n                        <i class=\"el-icon-back\"></i>\n                        退出登录\n                    </el-dropdown-item>\n                </el-dropdown-menu>\n            </el-dropdown>\n        </div>\n\n      <el-dialog title=\"密码修改\" :visible.sync=\"passwordParam.visible\" @close=\"passwordParam.close\" :close-on-click-modal=\"false\">\n        <r-form ref=\"myPasswordForm\" :rules=\"passwordRules\" :form=\"passwordForm\" :items=\"passwordItems\" :save=\"save\"></r-form>\n      </el-dialog>\n    </div>\n</template>\n\n<script>\n    import screenfull from \"screenfull\";\n    import local from \"../store/local\";\n    import {updatePassword} from \"../api/user\";\n    import RForm from \"@/components/RForm\";\n\n    export default {\n        name: \"Navbar\",\n        components: {RForm},\n        data() {\n            return {\n                account: local.getUserInfo().account,\n                passwordParam: {\n                  visible: false,\n                  close: this.close\n                },\n                passwordForm: {\n                  password: '',\n                  repassword: ''\n                },\n                passwordRules: {\n                  password: [{required: true, message: \"必填项不能为空\"}],\n                  repassword: [{required: true, message: \"必填项不能为空\"}],\n                },\n                passwordItems: [\n                  {type: 'password', label: '密码', prop: 'password', name: 'password', placeholder: '请录入密码'},\n                  {type: 'password', label: '重复密码', prop: 'repassword', name: 'repassword', placeholder: '请录入密码'},\n                ]\n            }\n        },\n        methods: {\n            handleFullScreen() {\n                screenfull.toggle();\n            },\n            handleCommand(type) {\n                if (type === 'home') {\n                    this.$router.push('/');\n                }\n                if (type === 'logout') {\n                    this.$confirm('确定要退出吗？', '退出提示').then(() => {\n                        //清除token和用户信息\n                        local.remove();\n                        this.$router.push('/');\n                    })\n                }\n                if (type === 'password') {\n                    this.openPassword();\n                }\n            },\n            close() {\n              this.passwordParam.visible = false;\n            },\n            openPassword() {\n              this.passwordParam.visible =true\n            },\n            save() {\n              let flag = this.$refs['myPasswordForm'].validateForm();\n              if (flag) {\n                if (this.passwordForm.password !== this.passwordForm.repassword) {\n                  this.$message.error(\"两次输入的密码不一致\");\n                  return;\n                }\n                //执行保存\n                updatePassword(this.passwordForm).then(res => {\n                  this.$message.success(res.msg);\n                  this.param.close();\n                  this.param.callback();\n                })\n              }\n            }\n        }\n    }\n</script>\n\n<style scoped>\n    .header {\n        height: 60px;\n        background-color: #009399;\n        width: 100%;\n        padding: 0;\n        line-height: 60px;\n        display: flex;\n    }\n\n    .collapse {\n        cursor: pointer;\n        padding: 0 20px;\n        color: #ffffff;\n    }\n\n    .user-info {\n        height: 60px;\n        margin-left: auto;\n        width: 300px;\n        padding-right: 20px;\n        text-align: right;\n    }\n\n    .el-dropdown {\n        margin-left: 10px;\n    }\n\n    .el-dropdown-link {\n        color: #ffffff;\n        cursor: pointer;\n    }\n\n    .user-info > i {\n        cursor: pointer;\n        padding: 10px 15px;\n        color: #ffffff;\n    }\n</style>"],"sourceRoot":"src/components"}]}