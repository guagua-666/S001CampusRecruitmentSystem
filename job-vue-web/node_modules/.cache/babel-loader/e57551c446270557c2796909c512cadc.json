A,OAJA;AAKA,KArBA;AAsBA,IAAA,IAtBA,kBAsBA;AAAA;;AACA,UAAA,IAAA,GAAA,KAAA,KAAA,CAAA,QAAA,EAAA,YAAA,EAAA;;AACA,UAAA,IAAA,EAAA;AACA,QAAA,OAAA,CAAA,GAAA,CAAA,KAAA,IAAA,CAAA,EAAA,EAAA,IAAA;;AACA,YAAA,KAAA,IAAA,CAAA,EAAA,EAAA;AACA,UAAA,MAAA,CAAA,KAAA,IAAA,CAAA,CAAA,IAAA,CAAA,UAAA,GAAA,EAAA;AACA,YAAA,MAAA,CAAA,QAAA,CAAA,OAAA,CAAA,GAAA,CAAA,GAAA;;AACA,YAAA,MAAA,CAAA,KAAA,CAAA,KAAA;;AACA,YAAA,MAAA,CAAA,KAAA,CAAA,QAAA;AACA,WAJA;AAKA,SANA,MAMA;AACA,UAAA,MAAA,CAAA,KAAA,IAAA,CAAA,CAAA,IAAA,CAAA,UAAA,GAAA,EAAA;AACA,YAAA,MAAA,CAAA,QAAA,CAAA,OAAA,CAAA,GAAA,CAAA,GAAA;;AACA,YAAA,MAAA,CAAA,KAAA,CAAA,KAAA;;AACA,YAAA,MAAA,CAAA,KAAA,CAAA,QAAA;AACA,WAJA;AAKA;AACA;AACA;AAxCA;AAlCA,CAAA","sourcesContent":["<template>\n    <div>\n        <r-form ref=\"myForm\" :rules=\"rules\" :form=\"form\" :items=\"items\" :save=\"save\"></r-form>\n    </div>\n</template>\n\n<script>\n    import RForm from \"@/components/RForm\";\n    import {stuJobInfoInfo, create, update} from '@/api/stuJobInfo'\n    import {dict_query} from \"@/api/dict\";\n\n    export default {\n        name: \"JobInfo\",\n        components: {RForm},\n        data() {\n            return {\n                form: {\n                    id: '',\n                    name: '',\n                    birthday: '',\n                    college: '',\n                    education: '',\n                    phone: '',\n                    sex: '',\n                    photo: '',\n                    graduateDate: ''\n                },\n                rules: {\n                    name: [{required: true, message: '必填项不能为空'}]\n                },\n                items: [\n                    {type: 'text', label: '学级', prop: 'grade', name: 'grade', placeholder: '请输入学级'},\n                    {type: 'text', label: '学号', prop: 'stuNo', name: 'stuNo', placeholder: '请输入学号'},\n                    {type: 'select', label: '就业与否', prop: 'employment', name: 'employment', placeholder: '就业与否', options: [{label: '是',value: '是'},{label: '否',value: '否'}]},\n                    {type: 'text', label: '就业公司名称', prop: 'companyName', name: 'companyName', placeholder: '就业公司名称'},\n                    {type: 'select', label: '单位性质', prop: 'companyType', name: 'companyType', placeholder: '国企或私企', options: []},\n                    {type: 'text', label: '工作岗位', prop: 'post', name: 'post', placeholder: '工作岗位'},\n                    {type: 'text', label: '工资数', prop: 'salary', name: 'salary', placeholder: '工资数'},\n                ]\n            }\n        },\n        mounted() {\n            this.getDictList1(7);\n            this.getInfo();\n        },\n        methods: {\n            getDictList1(typeId) {\n                dict_query({typeId: typeId}).then(res => {\n                    let arr = [];\n                    res.data.forEach(item => {\n                        let p = {value: item.dictKey, label: item.dictVal};\n                        arr.push(p);\n                    });\n                    this.items.forEach(item => {\n                        if (item.type == 'select' && item.name == 'companyType') {\n                            item.options = arr;\n                        }\n                    })\n                })\n            },\n            getInfo() {\n              stuJobInfoInfo().then(res => {\n                if (res.data) {\n                  this.form = res.data;\n                }\n              })\n            },\n            save() {\n                let flag = this.$refs['myForm'].validateForm();\n                if (flag) {\n                  console.log(this.form.id, 'id');\n                  if (this.form.id) {\n                    update(this.form).then(res => {\n                      this.$message.success(res.msg);\n                      this.param.close();\n                      this.param.callback();\n                    })\n                  } else {\n                    create(this.form).then(res => {\n                      this.$message.success(res.msg);\n                      this.param.close();\n                      this.param.callback();\n                    })\n                  }\n                }\n            }\n        }\n    }\n</script>\n\n<style scoped>\n\n</style>"],"sourceRoot":"src/views/student"}]}