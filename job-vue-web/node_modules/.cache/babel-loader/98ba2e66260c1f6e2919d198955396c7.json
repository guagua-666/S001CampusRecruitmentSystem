 selectedMenu = this.menus.filter(v => v.href == this.active)[0];\r\n                    } else {\r\n                        this.active = this.menus[0].href;\r\n                        selectedMenu = this.menus[0];\r\n                    }\r\n                    this.handleMenuItem(selectedMenu);\r\n                }\r\n            })\r\n        },\r\n        methods: {\r\n            handleMenuItem(item) {\r\n                this.$emit('handleMenuItem', item)\r\n            }\r\n        }\r\n    }\r\n</script>\r\n\r\n<style scoped>\r\n    .el-aside {\r\n        background-color: #20262E;\r\n    }\r\n\r\n    .logo {\r\n        height: 60px;\r\n        width: 200px;\r\n        color: #ffffff;\r\n        font-size: 18px;\r\n        font-weight: bold;\r\n        text-align: center;\r\n        line-height: 60px;\r\n    }\r\n\r\n    .logo img {\r\n        position: absolute;\r\n        width: 40px;\r\n        height: 40px;\r\n        left: 12px;\r\n        top: 8px;\r\n    }\r\n\r\n    .el-menu-item {\r\n        border-bottom: 1px solid #444444;\r\n    }\r\n</style>"],"sourceRoot":"src/components"}]}