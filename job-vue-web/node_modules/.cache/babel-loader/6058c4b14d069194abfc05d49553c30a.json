A,MAAA,CAAA,IAAA,GAAA,KAAA,IAAA;AACA,MAAA,OAAA,CAAA,GAAA,CAAA,MAAA;AACA,WAAA,IAAA,CAAA,MAAA;AACA,KApBA;AAqBA,IAAA,MArBA,oBAqBA;AACA,WAAA,IAAA,CAAA,KAAA,IAAA;AACA,KAvBA;AAwBA,IAAA,IAxBA,gBAwBA,MAxBA,EAwBA;AAAA;;AACA,MAAA,KAAA,CAAA,MAAA,CAAA,CAAA,IAAA,CAAA,UAAA,GAAA,EAAA;AACA,QAAA,KAAA,CAAA,SAAA,GAAA,GAAA,CAAA,IAAA;AACA,QAAA,KAAA,CAAA,KAAA,GAAA,GAAA,CAAA,KAAA;AACA,QAAA,OAAA,CAAA,GAAA,CAAA,KAAA,CAAA,SAAA;AACA,OAJA;AAKA,KA9BA;AA+BA,IAAA,KA/BA,mBA+BA;AACA,WAAA,GAAA,CAAA,OAAA,GAAA,KAAA;AACA,WAAA,IAAA,CAAA,OAAA,GAAA,KAAA;AACA,WAAA,OAAA,CAAA,OAAA,GAAA,KAAA;AACA,KAnCA;AAoCA,IAAA,SApCA,uBAoCA;AACA,WAAA,UAAA,CAAA,OAAA,GAAA,IAAA;AACA,KAtCA;AAuCA,IAAA,MAvCA,oBAuCA;AACA,WAAA,GAAA,CAAA,OAAA,GAAA,IAAA;AACA,KAzCA;AA0CA,IAAA,MA1CA,oBA0CA;AACA,UAAA,SAAA,GAAA,KAAA,KAAA,CAAA,cAAA,EAAA,SAAA;;AACA,UAAA,SAAA,CAAA,MAAA,IAAA,CAAA,EAAA;AACA,aAAA,IAAA,CAAA,OAAA,GAAA,IAAA;AACA,aAAA,IAAA,CAAA,IAAA,GAAA,SAAA,CAAA,CAAA,CAAA;AACA,OAHA,MAGA;AACA,QAAA,OAAA,CAAA,OAAA,CAAA,WAAA;AACA;AACA,KAlDA;AAmDA,IAAA,GAnDA,iBAmDA;AAAA;;AACA,UAAA,SAAA,GAAA,KAAA,KAAA,CAAA,cAAA,EAAA,SAAA;;AACA,UAAA,SAAA,CAAA,MAAA,GAAA,CAAA,EAAA;AACA,aAAA,QAAA,CAAA,QAAA,EAAA,MAAA,EAAA,IAAA,CAAA,YAAA;AACA,cAAA,GAAA,GAAA,SAAA,CAAA,GAAA,CAAA,UAAA,IAAA;AAAA,mBAAA,IAAA,CAAA,EAAA;AAAA,WAAA,CAAA;AACA,cAAA,GAAA,GAAA,GAAA,CAAA,IAAA,CAAA,GAAA,CAAA;;AACA,UAAA,IAAA,CAAA,GAAA,CAAA,CAAA,IAAA,CAAA,UAAA,GAAA,EAAA;AACA,YAAA,OAAA,CAAA,OAAA,CAAA,GAAA,CAAA,GAAA;;AACA,YAAA,MAAA,CAAA,MAAA;AACA,WAHA;AAIA,SAPA,EAOA,KAPA,CAOA,YAAA,CACA,CARA;AASA,OAVA,MAUA;AACA,QAAA,OAAA,CAAA,OAAA,CAAA,WAAA;AACA;AACA;AAlEA;AAtDA,CAAA","sourcesContent":["<template>\n    <div>\n        <div>\n        <r-query-form :form=\"form\" :items=\"items\" @search=\"search\"></r-query-form>\n        <div class=\"btn-panel\">\n            <el-button size=\"small\" type=\"primary\" icon=\"el-icon-plus\" @click=\"create\">新增</el-button>\n            <el-button size=\"small\" type=\"primary\" icon=\"el-icon-edit\" @click=\"update\">修改</el-button>\n            <el-button size=\"small\" type=\"danger\" icon=\"el-icon-delete\" @click=\"del\">删除</el-button>\n            <el-button size=\"small\" type=\"primary\" icon=\"el-icon-plus\" @click=\"open\">查看详情</el-button>\n        </div>\n        <r-table ref=\"mutipleTable\" :tableData=\"tableData\" :tableCols=\"tableCols\">\n            <template slot=\"slot_resume\" slot-scope=\"scope\">\n                {{scope.data.name}}\n            </template>\n        </r-table>\n        <r-pagination :page=\"page\" :total=\"total\" @handleCurrentChange=\"handleCurrentChange\"></r-pagination>\n        <Add v-if=\"add.visible\" :param=\"add\"></Add>\n        <Edit v-if=\"edit.visible\" :param=\"edit\"></Edit>\n        <JobList v-if=\"joblist.visible\" :param=\"joblist\"></JobList>\n    </div>\n\n    <div>\n        <el-dialog\n            :visible.sync=\"joblist.visible\"\n            width=\"60%\"\n            title=\"详情\"\n            @close=\"closeDialog\"\n        >\n          <div style=\"height:300px;text-align:center\">\n            <el-descriptions class=\"margin-top\"  :column=\"2\" border :labelStyle=\"{width: '100px'}\">\n              <el-descriptions-item>\n                <template slot=\"label\">\n                  招聘会名称\n                </template>\n                {{ joblistData.name }}\n              </el-descriptions-item>\n              <el-descriptions-item>\n                <template slot=\"label\">\n                  举办时间\n                </template>\n                {{ joblistData.jobDate }}\n              </el-descriptions-item>\n              <el-descriptions-item>\n                <template slot=\"label\">\n                  举办地点\n                </template>\n                {{ joblistData.jobPlace }}\n              </el-descriptions-item>\n              <el-descriptions-item>\n                <template slot=\"label\">\n                  参会单位\n                </template>\n                {{ joblistData.jobCompany }}\n              </el-descriptions-item>\n            </el-descriptions>\n          </div>\n        </el-dialog>\n    </div>\n\n</div>\n   \n</template>\n\n<script>\n    import {query} from \"@/api/joblist\";\n    import Add from './Add';\n    import Edit from \"./Edit\";\n    import JobList from \"./joblist\";\n    import {message} from \"@/utils/message\";\n    import {del} from '@/api/joblist'\n    import RTable from \"@/components/RTable\";\n    import RPagination from \"@/components/RPagination\";\n    import RQueryForm from \"../../components/RQueryForm\";\n    import {getByIdQuery} from \"@/api/joblist\";\n\n    export default {\n        name: \"Jobmeeting\",\n        components: {RQueryForm, RPagination, Edit, Add, RTable,JobList},\n        data() {\n            return {\n                total: 0,\n                page: 1,\n                joblistData:[],\n                jobCols: [\n                    {prop: 'id', label: 'ID', width: 80},\n                    {prop: 'name', label: '公司名称', slot: 'slot_resume'},\n                    {prop: 'jobPlace', label: '招聘岗位'},\n                    {prop: 'jobCompany', label: '招聘人数'},\n                    // {prop: 'jobUrl', label: '招聘地址'},\n                ],\n                tableData: [],\n                tableCols: [\n                    {prop: 'id', label: 'ID', width: 80},\n                    {prop: 'name', label: '招聘会名称', slot: 'slot_resume'},\n                    {prop: 'jobDate', label: '举办时间'},\n                    {prop: 'jobPlace', label: '举办地点'},\n                    {prop: 'jobCompany', label: '参会单位'},\n                ],\n                form: {\n                    name: '',\n                },\n                items: [\n                    {type: 'text', label: '招聘会名称', name: 'name', placeholder: '按招聘会名称查询'},\n                ],\n                add: {\n                    visible: false,\n                    close: this.close,\n                    callback: this.search\n                },\n                joblistadd: {\n                    visible: false,\n                    close: this.close,\n                    callback: this.search\n                },\n                edit: {\n                    visible: false,\n                    close: this.close,\n                    callback: this.search,\n                    form: null,\n                },\n                joblist: {\n                    visible: false,\n                    close: this.close\n                },\n            }\n        },\n        mounted() {\n            this.list({})\n        },\n        methods: {\n            closeDialog() {\n              this.list({})\n            },\n            /*展示具体类型项目*/\n            open() {\n                let selection = this.$refs['mutipleTable'].selection;\n                if (selection.length == 1) {\n                   this.joblist.visible =true\n                    this.joblistData = selection[0];\n                } else {\n                    message.warning('请选择一条数据查看')\n                }\n            },\n            handleCurrentChange(val) {\n                this.page = val;\n                let params = this.form;\n                params.page = this.page\n                console.log(params);\n                this.list(params);\n            },\n            search() {\n                this.list(this.form);\n            },\n            list(params) {\n                query(params).then(res => {\n                    this.tableData = res.data;\n                    this.total = res.total;\n                    console.log(this.tableData)\n                })\n            },\n            close() {\n                this.add.visible = false;\n                this.edit.visible = false;\n                this.joblist.visible = false;\n            },\n            jobcreate(){\n                this.joblistadd.visible=true\n            },\n            create() {\n                this.add.visible = true;\n            },\n            update() {\n                let selection = this.$refs['mutipleTable'].selection;\n                if (selection.length == 1) {\n                    this.edit.visible = true;\n                    this.edit.form = selection[0]\n                } else {\n                    message.warning('请选择一条数据修改')\n                }\n            },\n            del() {\n                let selection = this.$refs['mutipleTable'].selection;\n                if (selection.length > 0) {\n                    this.$confirm('确定要删除吗', '删除提示').then(() => {\n                        let arr = selection.map(item => item.id);\n                        let ids = arr.join(',');\n                        del(ids).then(res => {\n                            message.success(res.msg);\n                            this.search()\n                        })\n                    }).catch(() => {\n                    })\n                } else {\n                    message.warning('请选择要删除的数据')\n                }\n            }\n\n\n        }\n    }\n</script>\n\n<style scoped>\n\n</style>"],"sourceRoot":"src/views/jobmeeting"}]}