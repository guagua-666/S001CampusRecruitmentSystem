{"remainingRequest":"C:\\work\\code\\landlord\\S001CampusRecruitmentSystem\\job-vue-web\\node_modules\\vue-loader\\lib\\index.js??vue-loader-options!C:\\work\\code\\landlord\\S001CampusRecruitmentSystem\\job-vue-web\\src\\views\\send\\Send.vue?vue&type=script&lang=js&","dependencies":[{"path":"C:\\work\\code\\landlord\\S001CampusRecruitmentSystem\\job-vue-web\\src\\views\\send\\Send.vue","mtime":1710656682553},{"path":"C:\\work\\code\\landlord\\S001CampusRecruitmentSystem\\job-vue-web\\node_modules\\cache-loader\\dist\\cjs.js","mtime":1705575481000},{"path":"C:\\work\\code\\landlord\\S001CampusRecruitmentSystem\\job-vue-web\\node_modules\\babel-loader\\lib\\index.js","mtime":1705575481000},{"path":"C:\\work\\code\\landlord\\S001CampusRecruitmentSystem\\job-vue-web\\node_modules\\cache-loader\\dist\\cjs.js","mtime":1705575481000},{"path":"C:\\work\\code\\landlord\\S001CampusRecruitmentSystem\\job-vue-web\\node_modules\\vue-loader\\lib\\index.js","mtime":1705575481000}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["Send.vue"],"names":[],"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;AA2FA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA","file":"Send.vue","sourceRoot":"src/views/send","sourcesContent":["<template>\n    <div>\n        <div class=\"btn-panel\">\n            <el-button size=\"small\" type=\"primary\" icon=\"el-icon-plus\" @click=\"detail\">详情</el-button>\n            <el-button size=\"small\" type=\"danger\" icon=\"el-icon-delete\" @click=\"del\">删除</el-button>\n        </div>\n        <r-table ref=\"mutipleTable\" :tableData=\"tableData\" :tableCols=\"tableCols\">\n            <template slot=\"slot_post\" slot-scope=\"scope\">\n                {{scope.data.post.name}}\n            </template>\n            <template slot=\"slot_company\" slot-scope=\"scope\">\n                {{scope.data.company.name}}\n            </template>\n            <template slot=\"slot_student\" slot-scope=\"scope\">\n                {{scope.data.student.name}}\n            </template>\n            <template slot=\"slot_resume\" slot-scope=\"scope\">\n                {{scope.data.resume.name}}\n            </template>\n            <template slot=\"slot_status\" slot-scope=\"scope\">\n                <!--0待查看|1已查看|2有意向|3不合适-->\n                <el-tag v-if=\"scope.data.status == 0\">待查看</el-tag>\n                <el-tag type=\"info\" v-if=\"scope.data.status == 1\">已查看</el-tag>\n                <el-tag type=\"success\" v-if=\"scope.data.status == 2\">有意向</el-tag>\n                <el-tag type=\"danger\" v-if=\"scope.data.status == 3\">不合适</el-tag>\n            </template>\n        </r-table>\n        <r-pagination :page=\"page\" :total=\"total\" @handleCurrentChange=\"handleCurrentChange\"></r-pagination>\n\n      <el-dialog\n          :visible.sync=\"sendlist.visible\"\n          width=\"80%\"\n          title=\"简历详情\"\n          @close=\"closeDialog\"\n      >\n        <div style=\"height:800px;text-align:center\">\n          <el-descriptions class=\"margin-top\" :title=\"sendData.student.name + '的个人简历'\" :column=\"1\" border :labelStyle=\"{width: '100px'}\">\n            <template slot=\"extra\">\n              <span><el-input type=\"text\" style=\"width: 400px;margin-right:10px;\" v-model=\"form.reply\" placeholder=\"请输入回复内容\"></el-input></span>\n              <el-button type=\"success\" size=\"small\" @click=\"update('2')\">有意向</el-button>\n              <el-button type=\"danger\" size=\"small\" @click=\"update('3')\">不合适</el-button>\n            </template>\n            <el-descriptions-item>\n              <template slot=\"label\">\n                简历名称\n              </template>\n              {{ sendData.resume.name }}\n            </el-descriptions-item>\n            <el-descriptions-item>\n              <template slot=\"label\">\n                求职状态\n              </template>\n              {{ sendData.resume.jobStatus }}\n            </el-descriptions-item>\n            <el-descriptions-item>\n              <template slot=\"label\">\n                自我评价\n              </template>\n              <mavon-editor :value=\"sendData.resume.evaluate\"\n                            :toolbarsFlag=\"false\"\n                            :subfield=\"false\"\n                            :shortCut=\"false\"\n                            :autofocus=\"false\"\n                            :ishljs=\"true\"\n                            :boxShadow=\"false\"\n                            fontSize=\"16px\"\n                            previewBackground=\"#FFFFFF\"\n                            defaultOpen=\"preview\" />\n            </el-descriptions-item>\n            <el-descriptions-item>\n              <template slot=\"label\">\n                技能描述\n              </template>\n              <mavon-editor :value=\"sendData.resume.skill\"\n                            :toolbarsFlag=\"false\"\n                            :subfield=\"false\"\n                            :shortCut=\"false\"\n                            :autofocus=\"false\"\n                            :ishljs=\"true\"\n                            :boxShadow=\"false\"\n                            fontSize=\"16px\"\n                            previewBackground=\"#FFFFFF\"\n                            defaultOpen=\"preview\" />\n            </el-descriptions-item>\n          </el-descriptions>\n        </div>\n      </el-dialog>\n    </div>\n</template>\n\n<script>\n    import {query, update} from \"@/api/send\";\n    import {message} from \"@/utils/message\";\n    import {del} from '@/api/send'\n    import RTable from \"@/components/RTable\";\n    import RPagination from \"@/components/RPagination\";\n\n    export default {\n        name: \"Send\",\n        components: {RPagination, RTable},\n        data() {\n            return {\n                total: 0,\n                page: 1,\n                tableData: [],\n                tableCols: [\n                    {prop: 'id', label: 'ID', width: 80},\n                    {prop: 'postId', label: '职位', slot: 'slot_post'},\n                    {prop: 'companyId', label: '公司', slot: 'slot_company'},\n                    {prop: 'studentId', label: '学生姓名', slot: 'slot_student'},\n                    {prop: 'resumeId', label: '简历名称', slot: 'slot_resume'},\n                    {prop: 'status', label: '状态', slot: 'slot_status'},\n                    {prop: 'sendDate', label: '投递日期'},\n                ],\n                form: {\n                  id: '',\n                  status: '',\n                  reply: ''\n                },\n                items: [\n                    {type: 'text', label: '职位名称', name: 'postId', placeholder: '按关键字查询'},\n                ],\n                sendlist: {\n                  visible: false,\n                  close: this.close\n                },\n                sendData: {\n                  student: {},\n                  resume: {},\n                },\n            }\n        },\n        mounted() {\n            this.list({})\n        },\n        methods: {\n            handleCurrentChange(val) {\n                this.page = val;\n                let params = this.form;\n                params.page = this.page\n                console.log(params);\n                this.list(params);\n            },\n            list(params) {\n                query(params).then(res => {\n                    this.tableData = res.data;\n                    this.total = res.total;\n                })\n            },\n            detail() {\n              let selection = this.$refs['mutipleTable'].selection;\n              if (selection.length == 1) {\n                this.sendlist.visible =true\n                this.sendData = selection[0];\n                this.form.id = this.sendData.id\n                this.form.reply = this.sendData.reply\n                if (this.sendData.status == 0) {\n                  this.update(1);\n                }\n              } else {\n                message.warning('请选择一条数据查看')\n              }\n            },\n            closeDialog() {\n              this.sendlist.visible = false;\n              this.list({})\n            },\n            update(status) {\n              this.form.status = status\n              update(this.form).then(res => {\n                if (status != 1) {\n                  this.$message.success(res.msg);\n                }\n                this.param.close();\n                this.param.callback();\n              })\n            },\n            del() {\n                let selection = this.$refs['mutipleTable'].selection;\n                if (selection.length > 0) {\n                    this.$confirm('确定要删除吗', '删除提示').then(() => {\n                        let arr = selection.map(item => item.id);\n                        let ids = arr.join(',');\n                        del(ids).then(res => {\n                            message.success(res.msg);\n                            this.search()\n                        })\n                    }).catch(() => {\n                    })\n                } else {\n                    message.warning('请选择要删除的数据')\n                }\n            }\n        }\n    }\n</script>\n\n<style scoped>\n\n</style>"]}]}