{"remainingRequest":"C:\\work\\code\\landlord\\S001CampusRecruitmentSystem\\job-vue-web\\node_modules\\vue-loader\\lib\\index.js??vue-loader-options!C:\\work\\code\\landlord\\S001CampusRecruitmentSystem\\job-vue-web\\src\\views\\student\\StuJobList.vue?vue&type=script&lang=js&","dependencies":[{"path":"C:\\work\\code\\landlord\\S001CampusRecruitmentSystem\\job-vue-web\\src\\views\\student\\StuJobList.vue","mtime":1710751910788},{"path":"C:\\work\\code\\landlord\\S001CampusRecruitmentSystem\\job-vue-web\\node_modules\\cache-loader\\dist\\cjs.js","mtime":1705575481000},{"path":"C:\\work\\code\\landlord\\S001CampusRecruitmentSystem\\job-vue-web\\node_modules\\babel-loader\\lib\\index.js","mtime":1705575481000},{"path":"C:\\work\\code\\landlord\\S001CampusRecruitmentSystem\\job-vue-web\\node_modules\\cache-loader\\dist\\cjs.js","mtime":1705575481000},{"path":"C:\\work\\code\\landlord\\S001CampusRecruitmentSystem\\job-vue-web\\node_modules\\vue-loader\\lib\\index.js","mtime":1705575481000}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["StuJobList.vue"],"names":[],"mappings":";;;;;;;;;;;;;;;;;;AAkBA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA","file":"StuJobList.vue","sourceRoot":"src/views/student","sourcesContent":["<template>\n    <div>\n        <r-query-form :form=\"form\" :items=\"items\" @search=\"search\"></r-query-form>\n        <div class=\"btn-panel\">\n            <el-button size=\"small\" type=\"danger\" icon=\"el-icon-delete\" @click=\"del\">删除</el-button>\n        </div>\n\n        <r-table ref=\"mutipleTable\" :tableData=\"tableData\" :tableCols=\"tableCols\">\n            <template slot=\"sex_slot\" slot-scope=\"scope\">\n                <span v-if=\"scope.data.sex==0\">女</span>\n                <span v-else>男</span>\n            </template>\n        </r-table>\n        <r-pagination :page=\"page\" :total=\"total\" @handleCurrentChange=\"handleCurrentChange\"></r-pagination>\n    </div>\n</template>\n\n<script>\n    import {query, del} from \"@/api/stuJobInfo\";\n    import RTable from \"../../components/RTable\";\n    import RPagination from \"../../components/RPagination\";\n    import RQueryForm from \"../../components/RQueryForm\";\n    import {dict_query} from \"@/api/dict\";\n\n    export default {\n        name: \"StuJobList\",\n        components: {RQueryForm, RPagination, RTable},\n        data() {\n            return {\n                tableData: [],\n                tableCols: [\n                    {prop: 'id', label: 'ID', width: 80},\n                    {prop: 'name', label: '姓名'},\n                    {prop: 'grade', label: '学级'},\n                    {prop: 'stuNo', label: '学号'},\n                    {prop: 'employment', label: '就业与否'},\n                    {prop: 'companyName', label: '就业公司名称'},\n                    {prop: 'companyType', label: '单位性质'},\n                    {prop: 'post', label: '工作岗位', slot: 'sex_slot'},\n                    {prop: 'salary', label: '工资数'},\n                ],\n                total: 0,\n                page: 1,\n                form: {\n                    name: ''\n                },\n                items: [\n                    {type: 'text', label: '姓名', name: 'name', placeholder: '按姓名查询'},\n                    {type: 'text', label: '学号', name: 'stuNo', placeholder: '按学号查询'},\n                    {type: 'select', label: '单位性质', prop: 'companyType', name: 'companyType', placeholder: '国企或私企', options: []},\n                    {type: 'text', label: '工资', name: 'salary', placeholder: '按工资查询'},\n                ],\n            }\n        },\n        mounted() {\n            this.getDictList1(7);\n            this.list({});\n        },\n        methods: {\n            handleCurrentChange(val) {\n                this.page = val;\n                let params = this.form;\n                params.page = this.page;\n                this.list(params);\n            },\n            search() {\n                this.list(this.form);\n            },\n            list(params) {\n                query(params).then(res => {\n                    this.tableData = res.data;\n                    this.total = res.total;\n                })\n            },\n            getDictList1(typeId) {\n              dict_query({typeId: typeId}).then(res => {\n                let arr = [];\n                res.data.forEach(item => {\n                  let p = {value: item.dictKey, label: item.dictVal};\n                  arr.push(p);\n                });\n                this.items.forEach(item => {\n                  if (item.type == 'select' && item.name == 'companyType') {\n                    item.options = arr;\n                  }\n                })\n              })\n            },\n            del() {\n                let selections = this.$refs['mutipleTable'].selection;\n                if (selections.length > 0) {\n                    this.$confirm(\"确定有删除吗？\", \"删除提示\").then(() => {\n                        let arr = selections.map(item => item.id);\n                        let ids = arr.join(',');\n                        del(ids).then(res => {\n                            this.$message.success(res.msg);\n                            this.search();\n                        })\n                    }).catch(() => {\n                    })\n                } else {\n                    this.$message.warning(\"请选择要删除的数据\");\n                }\n            }\n        }\n    }\n</script>\n\n<style scoped>\n\n</style>"]}]}